---
import type { TimeZoneOption } from "../../lib/timezones";

interface SubjectOption {
  slug: string;
  name: string;
}

interface Props {
  context: "member" | "project";
  timezones: TimeZoneOption[];
  subjects?: SubjectOption[];
}

const { context, timezones, subjects = [] } = Astro.props;
const projectScoped = context === "project";
const assigneeHelpId = projectScoped ? "task-assignee-help" : "member-task-assignee-help";
---

<div class:list={["task-create-core-fields", projectScoped ? "task-create-core-fields--project" : ["create-grid", "task-create-core-fields--member"]]}>
  {!projectScoped && (
    <label>
      <span>プロジェクト</span>
      <select data-project data-task-project></select>
    </label>
  )}
  <label class="field-label">
    <span>タスク名</span>
    <input data-title data-task-title maxlength="200" placeholder="例：記事を確認する" />
  </label>
  {projectScoped && (
    <label class="field-label">
      <span>対象分野</span>
      <select data-task-subject>
        <option value="">全体</option>
        {subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}
      </select>
    </label>
  )}
  <label class="field-label">
    <span>担当者</span>
    <select data-assignee data-task-assignee data-selection-mode="tags" data-selection-label="担当者を検索" data-search-placeholder="名前・メール・分野担当グループを検索" multiple aria-describedby={assigneeHelpId}>
      <option value="" disabled>担当者を選択</option>
    </select>
    <small id={assigneeHelpId}>名前やメールで検索して複数人を選択できます。</small>
  </label>
  <div class="task-deadline">
    <label class="field-label">
      <span>期限</span>
      <input data-due data-task-due type="datetime-local" />
    </label>
    <label class="field-label">
      <span>期限のタイムゾーン</span>
      <select data-timezone data-task-due-timezone>
        {timezones.map(({ value, label }) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}
      </select>
    </label>
  </div>
</div>

<label class="details-field field-label">
  <span>補足・依頼内容</span>
  <textarea data-details data-task-details maxlength="10000" placeholder="目的、確認してほしい点、完了条件など"></textarea>
</label>

<label class="task-create-test-label" data-create-test-label data-test-task-create-label>
  <span><input type="checkbox" data-create-test data-task-create-test />テスト用タスク（通知を送らない）</span>
</label>

<style>
  .task-create-core-fields--member {
    display: grid;
    gap: .65rem;
    grid-template-columns: 1fr 1.5fr 1fr 1.5fr;
  }
  .task-create-core-fields--project {
    display: grid;
    gap: .65rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .task-create-core-fields--project .task-deadline {
    grid-column: 1 / -1;
  }
  .task-deadline {
    display: grid;
    gap: .65rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .field-label {
    color: var(--text-secondary);
    display: grid;
    font-size: .76rem;
    font-weight: 800;
    gap: .15rem;
    min-width: 0;
  }
  .task-create-core-fields :is(input, select) {
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    box-sizing: border-box;
    color: var(--text-primary);
    font: inherit;
    margin: .25rem 0;
    min-width: 0;
    padding: .55rem;
    width: 100%;
  }
  .task-create-core-fields small,
  .details-field { color: var(--text-secondary); font-size: .74rem; line-height: 1.4; }
  .details-field { display: grid; font-weight: 800; gap: .3rem; margin-top: .65rem; }
  .details-field textarea {
    background: var(--background-primary);
    border: 1px solid var(--border-default);
    box-sizing: border-box;
    color: var(--text-primary);
    font: inherit;
    font-weight: 400;
    min-height: 5rem;
    padding: .55rem;
    resize: vertical;
    width: 100%;
  }
  .task-create-test-label { display: grid; font-size: .76rem; font-weight: 700; margin-top: .65rem; }
  .task-create-test-label > span { align-items: center; display: flex; gap: .4rem; }
  .task-create-test-label input { height: .95rem; margin: 0; width: .95rem; }
  @media (max-width: 980px) {
    .task-create-core-fields--member { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 850px) {
    .task-create-core-fields--member { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .task-create-core-fields--member,
    .task-create-core-fields--project,
    .task-deadline {
      grid-template-columns: 1fr;
    }
  }
</style>
