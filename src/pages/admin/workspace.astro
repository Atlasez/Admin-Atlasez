---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminRetryNotice from "../../components/admin/AdminRetryNotice.astro";
import MemberProfileEditor from "../../components/admin/MemberProfileEditor.astro";
import MyAccess from "../../components/admin/MyAccess.astro";

const requestedProject = Astro.url.searchParams.get("project") ?? "atlas";
if (requestedProject === "portal") return Astro.redirect("/admin/member-profile/", 302);
const project = requestedProject === "secretariat" ? "secretariat" : requestedProject === "seminar-platform" ? "seminar-platform" : "atlas";
const projectLabel = project === "secretariat" ? "Atlasez運営事務局" : project === "seminar-platform" ? "ゼミプラットフォーム" : "学習サイト「アトラス」運営";
const isAtlas = project === "atlas";
---

<AdminLayout title={`${projectLabel} 担当・自己紹介`} description="プロフィールやプロジェクト内の担当を確認します">
  <main class="personal-workspace" data-personal-workspace data-project={project} data-atlas={String(isAtlas)} data-admin-load-surface aria-busy="true">
    <header class="workspace-heading">
      <h1>担当・自己紹介</h1>
      <div class="heading-actions">
        <a class="quiet-action" data-profile-review-link hidden href={`/admin/project-profile-requests/?project=${project}`}>自己紹介の承認</a>
        <button class="primary-action" type="button" data-open-profile-edit aria-haspopup="dialog">プロフィールを編集</button>
      </div>
    </header>

    <AdminRetryNotice message="プロフィール情報を読み込めませんでした。" />

    <section class="profile-card" aria-labelledby="profile-heading">
      <div class="profile-top">
        <div class="avatar" data-profile-avatar aria-hidden="true"><span data-profile-avatar-fallback>A</span></div>
        <div class="profile-identity">
          <h2 id="profile-heading" data-profile-name>読み込み中…</h2>
          <p data-profile-email></p>
        </div>
      </div>

      <section class="discord-card" aria-labelledby="discord-heading">
        <div class="discord-card__heading"><h2 id="discord-heading">Discord連携</h2><span class="discord-card__status" data-discord-status data-state="unconnected">未連携</span></div>
        <p data-discord-description>Discordサーバー参加に必要な本人同意を行えます。</p>
        <a class="discord-card__action" data-discord-link href={`/auth/discord/start?returnTo=${encodeURIComponent(`/admin/workspace/?project=${project}`)}`}>Discordと連携</a>
        <output data-discord-message aria-live="polite"></output>
      </section>

      <dl class="profile-facts">
        <div><dt>氏名</dt><dd data-fact="display_name">読み込み中…</dd></div>
        <div><dt>学校・所属</dt><dd data-fact="university">—</dd></div>
        <div><dt>学年等</dt><dd data-fact="year">—</dd></div>
        <div><dt>所属区分</dt><dd data-fact="affiliation_type">—</dd></div>
        <div><dt>国・地域</dt><dd data-fact="country">—</dd></div>
        <div><dt>タイムゾーン</dt><dd data-fact="timezone">—</dd></div>
      </dl>

      <section class="bio-card" aria-labelledby="bio-heading">
        <div class="section-heading"><h2 id="bio-heading">運営内自己紹介</h2><div class="section-actions"><a class="quiet-action" data-project-introductions-link href={`/admin/introductions/?project=${project}`}>自己紹介一覧を見る</a><button class="quiet-action" type="button" data-open-project-bio-edit aria-haspopup="dialog">編集</button></div></div>
        <p data-project-bio>読み込み中…</p>
        <aside class="project-request-notice" data-project-request-notice hidden aria-live="polite">
          <span data-project-request-message></span>
          <button class="notice-dismiss" type="button" data-dismiss-project-request hidden>閉じる</button>
        </aside>
      </section>

      <section class="assignment-panel" aria-labelledby="assignment-heading">
        <h2 id="assignment-heading">プロジェクト内での担当</h2>
        <ul data-assignments><li>確認中…</li></ul>
      </section>

      <MyAccess />
      <output class="profile-message" data-project-profile-message aria-live="polite"></output>
    </section>

    <dialog class="project-profile-dialog" data-project-profile-dialog aria-labelledby="project-profile-dialog-heading">
      <form class="project-profile-editor" data-project-profile-form>
        <header class="dialog-heading">
          <div><h2 id="project-profile-dialog-heading">運営内自己紹介を編集</h2><p>変更は承認後に反映されます。</p></div>
          <button class="dialog-close" type="button" data-close-project-profile-edit aria-label="閉じる">×</button>
        </header>
        <label>自己紹介<textarea name="internalBio" rows="8" maxlength="4000" placeholder="担当・関心・作業可能なことなど。リンクは [表示名](https://example.com/) の形式で入力できます。"></textarea></label>
        <section class="project-profile-preview" aria-labelledby="project-profile-preview-heading">
          <h3 id="project-profile-preview-heading">プレビュー</h3>
          <p data-project-profile-preview>自己紹介はまだ登録されていません。</p>
        </section>
        <div class="form-actions">
          <output data-project-profile-editor-message aria-live="polite"></output>
          <div><button class="quiet-action" type="button" data-close-project-profile-edit>閉じる</button><button type="submit" class="primary-action">変更を承認申請</button></div>
        </div>
      </form>
    </dialog>

    {isAtlas && <div class="workspace-grid" data-article-workspace hidden data-admin-load-surface data-admin-load-state="loading" aria-busy="true">
      <section class="personal-note" aria-labelledby="note-heading">
        <div class="section-heading"><div><h2 id="note-heading">個人メモ</h2></div><output data-note-message aria-live="polite"></output></div>
        <textarea data-private-note maxlength="12000" placeholder="例：次は群作用の記事の具体例を追加する。参考文献：…"></textarea>
        <div class="note-actions"><small data-note-updated></small><button type="button" class="primary-action" data-save-note>個人メモを保存</button></div>
      </section>
      <section class="my-documents" aria-labelledby="documents-heading">
        <div class="section-heading"><div><h2 id="documents-heading">担当原稿</h2></div></div>
        <div class="document-list" data-my-documents><p class="loading-state">読み込み中…</p></div>
      </section>
      <AdminRetryNotice scope="workspace" message="個人メモと担当原稿を読み込めませんでした。" />
      <p class="empty" data-admin-empty-state hidden></p>
    </div>}
  </main>
  <MemberProfileEditor />
</AdminLayout>

<style>
  .personal-workspace [hidden]{display:none!important}
  .personal-workspace{--surface:var(--background-primary);--alt:var(--background-secondary);--border:var(--border-default);--text:var(--text-primary);--muted:var(--text-secondary);--accent:var(--accent-primary);box-sizing:border-box;color:var(--text);margin:0 auto;max-width:1480px;padding:0 1.25rem 4rem}
  .workspace-heading{align-items:center;border-bottom:1px solid var(--border);display:flex;gap:1rem;justify-content:space-between;padding:2rem 0 1.25rem}
  .workspace-heading h1{font-size:clamp(1.8rem,4vw,2.35rem);margin:0}
  .heading-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.6rem}
  .primary-action,.quiet-action{align-items:center;display:inline-flex;justify-content:center;min-height:2.5rem;padding:.55rem .85rem;text-decoration:none}
  .primary-action{background:var(--accent);border:1px solid var(--accent);color:#fff;cursor:pointer;font:inherit;font-size:.84rem;font-weight:800}
  .quiet-action{background:var(--surface);border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.8rem;font-weight:700}
  .profile-card{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:1.1rem;margin:1.25rem 0;padding:clamp(1rem,2vw,1.5rem)}
  .profile-top{align-items:center;display:flex;gap:1.5rem;min-width:0}
  .avatar{align-items:center;background:var(--accent);border:1px solid var(--border);border-radius:50%;color:var(--on-accent);display:flex;flex:0 0 9rem;font-size:2.5rem;font-weight:800;height:9rem;justify-content:center;overflow:hidden;width:9rem}
  .profile-identity{min-width:0}.profile-identity h2{font-size:clamp(1.35rem,2.3vw,1.8rem);margin:0 0 .35rem;overflow-wrap:anywhere}.profile-identity p{color:var(--muted);margin:0;overflow-wrap:anywhere}
  .discord-card{background:var(--alt);border:1px solid var(--border);display:grid;gap:.7rem;padding:1rem}
  .discord-card__heading{align-items:center;display:flex;gap:1rem;justify-content:space-between}.discord-card h2{font-size:1.2rem;margin:0}
  .discord-card__status{border:1px solid var(--border);border-radius:999px;font-size:.8rem;font-weight:800;padding:.3rem .75rem;white-space:nowrap}.discord-card__status[data-state=connected]{color:#20874f}
  .discord-card p{line-height:1.65;margin:0}.discord-card__action{background:var(--accent);color:#fff;display:inline-flex;font-size:.82rem;font-weight:800;justify-self:start;padding:.65rem .85rem;text-decoration:none}
  .discord-card output,.profile-message{color:var(--muted);font-size:.8rem;min-height:1em}
  .profile-facts{display:grid;gap:.65rem;grid-template-columns:repeat(3,minmax(0,1fr));margin:0}
  .profile-facts div{background:var(--alt);border:1px solid var(--border);padding:.7rem}.profile-facts dt{color:var(--muted);font-size:.73rem;font-weight:800}.profile-facts dd{font-size:.95rem;margin:.3rem 0 0;overflow-wrap:anywhere}
  .bio-card{border-bottom:1px solid var(--border);border-top:1px solid var(--border);display:grid;gap:.65rem;padding:1rem 0}
  .section-heading{align-items:center;display:flex;gap:1rem;justify-content:space-between}.section-heading h2{font-size:1.1rem;margin:0}.section-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.45rem}.bio-card>p{line-height:1.75;margin:0;overflow-wrap:anywhere;white-space:pre-wrap}.bio-card a,.project-profile-preview a{color:var(--accent);font-weight:700}
  .project-request-notice{align-items:start;background:var(--alt);border-left:3px solid var(--accent);display:flex;gap:.75rem;justify-content:space-between;padding:.65rem .75rem}.project-request-notice[hidden]{display:none}.project-request-notice span{line-height:1.5}.notice-dismiss{background:transparent;border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:.75rem;padding:.25rem .5rem}
  .assignment-panel{background:var(--alt);border:1px solid var(--border);display:grid;gap:.65rem;padding:.85rem}.assignment-panel h2{font-size:1.05rem;margin:0}.assignment-panel ul{display:flex;flex-wrap:wrap;gap:.45rem;list-style:none;margin:0;padding:0}.assignment-panel li{background:var(--surface);border:1px solid var(--border);font-size:.8rem;font-weight:800;padding:.4rem .6rem}
  .project-profile-dialog{background:var(--surface);border:1px solid var(--border);border-radius:.65rem;color:var(--text);margin:auto;max-height:min(92dvh,900px);max-width:min(760px,calc(100vw - 1.5rem));overflow:auto;padding:0;width:100%}.project-profile-dialog::backdrop{backdrop-filter:blur(2px);background:rgb(12 18 26 / 55%)}
  .project-profile-editor{display:grid;gap:1rem;padding:clamp(1rem,3vw,1.6rem)}.dialog-heading{align-items:start;border-bottom:1px solid var(--border);display:flex;gap:1rem;justify-content:space-between;padding-bottom:.8rem}.dialog-heading h2{font-size:1.3rem;margin:0}.dialog-heading p{color:var(--muted);font-size:.85rem;margin:.35rem 0 0}.dialog-close{background:transparent;border:1px solid var(--border);color:var(--text);cursor:pointer;font:inherit;font-size:1.3rem;height:2.3rem;width:2.3rem}
  .project-profile-editor label{display:grid;font-size:.85rem;font-weight:800;gap:.4rem}.project-profile-editor textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;line-height:1.65;min-height:12rem;padding:.7rem;resize:vertical;width:100%}.project-profile-preview{background:var(--alt);border:1px solid var(--border);padding:.7rem .8rem}.project-profile-preview h3{color:var(--muted);font-size:.75rem;margin:0 0 .35rem}.project-profile-preview p{line-height:1.65;margin:0;overflow-wrap:anywhere;white-space:pre-wrap}
  .form-actions{align-items:center;display:flex;flex-wrap:wrap;gap:.65rem;justify-content:space-between}.form-actions output{color:var(--muted);font-size:.8rem;min-height:1em}.form-actions>div{display:flex;flex-wrap:wrap;gap:.5rem}
  .workspace-grid[hidden]{display:none!important}.workspace-grid{align-items:start;display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin-top:1.25rem}.personal-note,.my-documents{border:1px solid var(--border);border-top:2px solid var(--accent);display:grid;gap:1rem;margin:0;padding:1rem}.workspace-grid .section-heading{align-items:start}.workspace-grid .section-heading h2{font-size:1.1rem;margin:0}.workspace-grid .section-heading output{color:var(--muted);font-size:.78rem;max-width:12rem;text-align:right}.personal-note textarea{background:var(--surface);border:1px solid var(--border);box-sizing:border-box;color:var(--text);font:inherit;line-height:1.65;min-height:18rem;padding:.7rem;resize:vertical;width:100%}.note-actions{align-items:center;display:flex;gap:.65rem;justify-content:space-between}.note-actions small{color:var(--muted)}.document-list{display:grid;gap:.5rem}.document-card{background:var(--alt);border:1px solid var(--border);color:var(--text);display:grid;gap:.3rem;padding:.65rem .7rem;text-decoration:none}.document-card:hover{box-shadow:inset 0 0 0 1px var(--accent)}.document-card-top{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.document-card b{font-size:.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.document-card small{color:var(--muted);font-size:.74rem}.document-edit-link{color:var(--accent);font-size:.74rem;font-weight:800}.state{border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.68rem;font-weight:800;padding:.12rem .35rem;white-space:nowrap}.state-in-review{background:#fff0c6}.state-on-hold{background:#f4e5e7}.state-approved{background:#def4e6}.empty{color:var(--muted);padding:2rem 0;text-align:center}
  @media(max-width:760px){.personal-workspace{padding:0 .9rem 3rem}.workspace-heading{align-items:start;display:grid}.heading-actions{justify-self:start}.profile-top{align-items:flex-start;gap:1rem}.avatar{flex-basis:7.5rem;font-size:2rem;height:7.5rem;width:7.5rem}.profile-facts{grid-template-columns:repeat(2,minmax(0,1fr))}.discord-card__action{justify-self:stretch;text-align:center}.workspace-grid{grid-template-columns:1fr}.note-actions,.workspace-grid .section-heading{align-items:start;display:grid}.workspace-grid .section-heading output{text-align:left}.form-actions{align-items:stretch;display:grid}.form-actions>div{justify-content:end}}
</style>

<script>
  import { createAdminLoadRetry } from "../../scripts/admin-load-retry";
  import { setProfileAvatar } from "../../scripts/profile-avatar";
  import { renderSafeLinks } from "../../lib/safe-links";

  type PersonalDocument = { id: string; subject: string; category: string; title: string; status: "draft" | "in-review" | "on-hold" | "approved"; updated_at: string; published_at: string | null };
  type Profile = { display_name?: string; university?: string; year?: string; affiliation_type?: string; country?: string; timezone?: string; bio?: string; avatar_url?: string };
  type MemberProfileResponse = { profile?: Profile; email?: string; discordUserId?: string; error?: string };
  type ProjectProfileResponse = { project?: { id: string; name: string }; assignments?: string[]; canEditArticles?: boolean; canReview?: boolean; projectProfile?: { internal_bio?: string }; profileChangeRequest?: { id?: string; status?: string; proposed_internal_bio?: string; review_note?: string }; error?: string };

  const initializeProjectWorkspace = () => {
    const root = document.querySelector<HTMLElement>("[data-personal-workspace]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const queryProject = new URLSearchParams(location.search).get("project")?.trim().toLowerCase();
    if (queryProject === "portal") {
      location.replace("/admin/member-profile/");
      return;
    }
    const projectId = queryProject && /^[a-z0-9][a-z0-9-]{0,79}$/.test(queryProject)
      ? queryProject
      : root.dataset.project ?? "atlas";
    const isAtlas = projectId === "atlas";
    root.dataset.project = projectId;
    root.dataset.atlas = String(isAtlas);
    root.querySelectorAll<HTMLAnchorElement>('a[href*="?project="]').forEach((link) => {
      const target = new URL(link.href, location.origin);
      target.searchParams.set("project", projectId);
      link.href = target.pathname + target.search;
    });
    const reviewLink = root.querySelector<HTMLAnchorElement>("[data-profile-review-link]");
    if (reviewLink) reviewLink.href = `/admin/project-profile-requests/?project=${encodeURIComponent(projectId)}`;
    const introductionsLink = root.querySelector<HTMLAnchorElement>("[data-project-introductions-link]");
    if (introductionsLink) introductionsLink.href = `/admin/introductions/?project=${encodeURIComponent(projectId)}`;

    const name = root.querySelector<HTMLElement>("[data-profile-name]")!;
    const email = root.querySelector<HTMLElement>("[data-profile-email]")!;
    const assignments = root.querySelector<HTMLElement>("[data-assignments]")!;
    const projectBio = root.querySelector<HTMLElement>("[data-project-bio]")!;
    const projectForm = root.querySelector<HTMLFormElement>("[data-project-profile-form]")!;
    const projectBioField = projectForm.elements.namedItem("internalBio") as HTMLTextAreaElement;
    const projectBioPreview = root.querySelector<HTMLElement>("[data-project-profile-preview]")!;
    const projectDialog = root.querySelector<HTMLDialogElement>("[data-project-profile-dialog]")!;
    const projectMessage = root.querySelector<HTMLOutputElement>("[data-project-profile-message]")!;
    const projectEditorMessage = root.querySelector<HTMLOutputElement>("[data-project-profile-editor-message]")!;
    const requestNotice = root.querySelector<HTMLElement>("[data-project-request-notice]")!;
    const requestMessage = root.querySelector<HTMLElement>("[data-project-request-message]")!;
    const dismissRequest = root.querySelector<HTMLButtonElement>("[data-dismiss-project-request]")!;
    let canUseArticleWorkspace = false;
    let approvedProjectBio = "";
    let dismissedRequestKey = "";

    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char);
    const readJson = async <T,>(response: Response): Promise<T> => {
      if (!(response.headers.get("content-type") ?? "").includes("application/json")) {
        throw new Error("認証が切れました。ページを再読み込みしてください。");
      }
      return await response.json() as T;
    };
    const formatDate = (value: string) => new Intl.DateTimeFormat("ja-JP", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
    const updateBioPreview = (value: string) => {
      projectBioPreview.innerHTML = renderSafeLinks(value.trim() || "自己紹介はまだ登録されていません。");
    };
    const applyProjectRequest = (request?: ProjectProfileResponse["profileChangeRequest"]) => {
      requestNotice.hidden = true;
      requestMessage.textContent = "";
      dismissRequest.hidden = true;
      dismissedRequestKey = "";
      if (request?.status === "pending") {
        requestMessage.textContent = "自己紹介の変更申請は承認待ちです。";
        requestNotice.hidden = false;
        return;
      }
      if (request?.status !== "rejected") return;
      dismissedRequestKey = request.id ? `atlasez-project-profile-request-dismissed:${request.id}` : "";
      try {
        if (dismissedRequestKey && localStorage.getItem(dismissedRequestKey) === "true") return;
      } catch {
        // Keep the notice dismissible for this page view when storage is unavailable.
      }
      requestMessage.textContent = `直近の自己紹介変更申請は却下されました。${request.review_note ? `理由: ${request.review_note}` : ""}`;
      dismissRequest.hidden = false;
      requestNotice.hidden = false;
    };
    dismissRequest.addEventListener("click", () => {
      if (dismissedRequestKey) {
        try { localStorage.setItem(dismissedRequestKey, "true"); } catch { /* Keep this dismissal for the current view. */ }
      }
      requestNotice.hidden = true;
    });

    const applyMemberProfile = (data: MemberProfileResponse) => {
      const profile = data.profile ?? {};
      const displayName = profile.display_name?.trim() || "表示名未設定";
      name.textContent = displayName;
      email.textContent = data.email ?? "";
      root.querySelector<HTMLElement>("[data-fact=display_name]")!.textContent = displayName || "未登録";
      for (const key of ["university", "year", "affiliation_type", "country", "timezone"] as const) {
        root.querySelector<HTMLElement>(`[data-fact=${key}]`)!.textContent = profile[key]?.trim() || "未登録";
      }
      const avatar = root.querySelector<HTMLElement>("[data-profile-avatar]")!;
      setProfileAvatar(avatar, profile.avatar_url ?? "", displayName.slice(0, 1) || "A");
      const connected = Boolean(data.discordUserId?.trim());
      const status = root.querySelector<HTMLElement>("[data-discord-status]")!;
      status.textContent = connected ? "連携済み" : "未連携";
      status.dataset.state = connected ? "connected" : "unconnected";
      root.querySelector<HTMLElement>("[data-discord-description]")!.textContent = connected
        ? "Discordアカウントは連携済みです。必要に応じて連携先を更新できます。"
        : "Discordサーバー参加に必要な本人同意を行えます。";
      const discordLink = root.querySelector<HTMLAnchorElement>("[data-discord-link]")!;
      discordLink.textContent = connected ? "Discord連携を更新" : "Discordと連携";
      discordLink.href = `/auth/discord/start?returnTo=${encodeURIComponent(`/admin/workspace/?project=${projectId}`)}`;
    };

    const applyProjectProfile = (data: ProjectProfileResponse, member: Profile) => {
      const reviewLink = root.querySelector<HTMLElement>("[data-profile-review-link]");
      if (reviewLink) reviewLink.hidden = data.canReview !== true;
      canUseArticleWorkspace = isAtlas && data.canEditArticles === true;
      const articleWorkspace = root.querySelector<HTMLElement>("[data-article-workspace]");
      if (articleWorkspace) articleWorkspace.hidden = !canUseArticleWorkspace;
      assignments.innerHTML = (data.assignments ?? []).map((label) => `<li>${escapeHtml(label)}</li>`).join("") || "<li>担当未設定</li>";
      const request = data.profileChangeRequest;
      approvedProjectBio = data.projectProfile?.internal_bio?.trim() ?? "";
      projectBio.textContent = approvedProjectBio || member.bio?.trim() || "自己紹介はまだ登録されていません。";
      projectBioField.value = request?.status === "pending" ? request.proposed_internal_bio ?? "" : approvedProjectBio;
      updateBioPreview(projectBioField.value);
      applyProjectRequest(request);
    };

    let loadProfile: () => Promise<void> = async () => undefined;
    const retry = createAdminLoadRetry(root, () => loadProfile(), "プロフィール情報を読み込めませんでした。");
    loadProfile = async () => {
      retry.begin();
      try {
        const [memberResponse, projectResponse] = await Promise.all([
          fetch("/api/admin/profile", { credentials: "same-origin", cache: "no-store" }),
          fetch(`/api/admin/project-profile?project=${encodeURIComponent(projectId)}`, { credentials: "same-origin", cache: "no-store" }),
        ]);
        const [memberData, projectData] = await Promise.all([
          readJson<MemberProfileResponse>(memberResponse),
          readJson<ProjectProfileResponse>(projectResponse),
        ]);
        if (!memberResponse.ok) throw new Error(memberData.error ?? "プロフィール情報を読み込めませんでした。");
        if (!projectResponse.ok) throw new Error(projectData.error ?? "プロジェクト情報を読み込めませんでした。");
        applyMemberProfile(memberData);
        applyProjectProfile(projectData, memberData.profile ?? {});
        retry.success();
      } catch (error) {
        retry.fail(error);
        throw error;
      }
    };

    projectBioField.addEventListener("input", (event) => updateBioPreview((event.target as HTMLTextAreaElement).value));
    root.querySelector<HTMLButtonElement>("[data-open-project-bio-edit]")!.addEventListener("click", () => {
      if (!projectDialog.open) projectDialog.showModal();
      projectBioField.focus();
    });
    root.querySelectorAll<HTMLButtonElement>("[data-close-project-profile-edit]").forEach((button) => button.addEventListener("click", () => projectDialog.close()));
    projectDialog.addEventListener("click", (event) => { if (event.target === projectDialog) projectDialog.close(); });
    projectForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = projectForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      projectEditorMessage.value = "申請中…";
      projectMessage.value = "";
      try {
        const response = await fetch("/api/admin/project-profile", {
          method: "PUT",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ projectId, internalBio: projectBioField.value }),
        });
        const data = await readJson<{ approvalRequired?: boolean; noChange?: boolean; error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "変更申請を送れませんでした。");
        if (data.noChange) {
          projectEditorMessage.value = "承認済みの内容から変更はありません。";
          return;
        }
        projectEditorMessage.value = isAtlas ? "運営事務局へ承認申請を送りました。" : "プロジェクトの運営へ承認タスクを送りました。";
        projectMessage.value = projectEditorMessage.value;
        await loadProfile();
        projectDialog.close();
      } catch (error) {
        projectEditorMessage.value = error instanceof Error ? error.message : "変更申請を送れませんでした。";
      } finally {
        button.disabled = false;
      }
    });

    const note = root.querySelector<HTMLTextAreaElement>("[data-private-note]");
    const noteMessage = root.querySelector<HTMLOutputElement>("[data-note-message]");
    const noteUpdated = root.querySelector<HTMLElement>("[data-note-updated]");
    const documents = root.querySelector<HTMLElement>("[data-my-documents]");
    const saveNote = root.querySelector<HTMLButtonElement>("[data-save-note]");
    let loadAtlasWorkspace: () => Promise<void> = async () => undefined;
    const workspaceRetry = createAdminLoadRetry(root, () => loadAtlasWorkspace(), "個人メモと担当原稿を読み込めませんでした。", { scope: "workspace" });
    loadAtlasWorkspace = async () => {
      if (!canUseArticleWorkspace || !note || !noteMessage || !noteUpdated || !documents || !saveNote) {
        workspaceRetry.success();
        return;
      }
      workspaceRetry.begin();
      try {
        const response = await fetch("/api/admin/personal-workspace", { credentials: "same-origin", cache: "no-store" });
        const data = await readJson<{ privateNote?: string; privateNoteUpdatedAt?: string | null; documents?: PersonalDocument[]; error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "個人ワークスペースを読み込めませんでした。");
        note.value = data.privateNote ?? "";
        noteUpdated.textContent = data.privateNoteUpdatedAt ? `最終保存：${formatDate(data.privateNoteUpdatedAt)}` : "まだ保存されていません";
        const labels = { draft: "下書き", "in-review": "フィードバック中", "on-hold": "保留", approved: "フィードバック済み" } as const;
        const items = data.documents ?? [];
        documents.innerHTML = items.map((item) => `<a class="document-card" href="/admin/editor/?document=${encodeURIComponent(item.id)}"><div class="document-card-top"><b>${escapeHtml(item.title || "無題の原稿")}</b><span class="state state-${item.status}">${labels[item.status]}</span></div><small>${escapeHtml(item.subject)} / ${escapeHtml(item.category)} ・ 最終更新 ${formatDate(item.updated_at)}${item.published_at ? " ・ 公開済み" : ""}</small><span class="document-edit-link" aria-hidden="true">→</span></a>`).join("");
        if (items.length) workspaceRetry.success();
        else workspaceRetry.empty("自分が作成した原稿はまだありません。");
      } catch (error) {
        documents.innerHTML = "";
        workspaceRetry.fail(error);
        throw error;
      }
    };
    saveNote?.addEventListener("click", async () => {
      if (!note || !noteMessage || !noteUpdated || !saveNote) return;
      saveNote.disabled = true;
      noteMessage.value = "保存中…";
      try {
        const response = await fetch("/api/admin/personal-workspace", { method: "PUT", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify({ privateNote: note.value }) });
        const data = await readJson<{ updatedAt?: string; error?: string }>(response);
        if (!response.ok) throw new Error(data.error ?? "保存できませんでした。");
        noteUpdated.textContent = data.updatedAt ? `最終保存：${formatDate(data.updatedAt)}` : "保存しました";
        noteMessage.value = "保存しました。";
      } catch (error) {
        noteMessage.value = error instanceof Error ? error.message : "保存できませんでした。";
      } finally {
        saveNote.disabled = false;
      }
    });
    void loadProfile().then(() => loadAtlasWorkspace()).catch((error) => { projectMessage.value = error instanceof Error ? error.message : "プロフィール情報を読み込めませんでした。"; });
  };

  document.addEventListener("astro:page-load", initializeProjectWorkspace);
  initializeProjectWorkspace();
</script>
