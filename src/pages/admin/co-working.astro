---
import AdminLayout from "../../layouts/AdminLayout.astro";
const requestedProject = Astro.url.searchParams.get("project");
const operationProject = ["secretariat", "seminar-platform", "student-council-exchange", "thinking-cafe"].includes(requestedProject ?? "") ? requestedProject! : "atlas";
const calendarHref = `/admin/calendar/?project=${encodeURIComponent(operationProject)}`;
---
<AdminLayout title="同時作業会" description="同時作業会の予定と参加状況">
  <main class="co-working">
    <header class="page-heading">
      <h1>同時作業会</h1>
      <p>開催予定、定期枠、参加可否はプロジェクトのカレンダーにまとめています。</p>
    </header>
    <a class="calendar-link" href={calendarHref}>カレンダーを開く <span aria-hidden="true">→</span></a>
  </main>
</AdminLayout>
<style>
  .co-working { margin: 0 auto; max-width: 900px; padding: 0 1.25rem 4rem; }
  .page-heading { border-bottom: 1px solid var(--border-default); padding: 2.2rem 0 1.4rem; }
  .page-heading h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .25rem 0; }
  .page-heading p { color: var(--text-secondary); font-size: .85rem; line-height: 1.6; margin: .5rem 0 0; }
  .calendar-link { align-items: center; background: var(--accent-primary); color: #fff; display: inline-flex; font-size: .82rem; font-weight: 800; gap: .5rem; margin-top: 1.25rem; padding: .75rem 1rem; text-decoration: none; }
  .calendar-link:hover { filter: brightness(.94); }
  @media (max-width: 700px) { .co-working { padding: 0 .8rem 3rem; } }
</style>
